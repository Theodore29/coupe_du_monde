<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏆 Matchs du jour — Coupe du Monde 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #07090f;
    --card: #0f1520;
    --border: #1c2d47;
    --gold: #f0b429;
    --gold-dim: rgba(240,180,41,0.15);
    --green: #22c55e;
    --red: #ef4444;
    --text: #e2eaf8;
    --muted: #5a7499;
    --accent: #3b82f6;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Figtree', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  body::before {
    content: '';
    position: fixed;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px; height: 400px;
    background: radial-gradient(ellipse, rgba(240,180,41,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 640px;
    padding: 0 16px 60px;
  }

  /* ── HEADER ── */
  header { text-align: center; padding: 36px 0 24px; }
  .logo { font-size: 2.2rem; display: block; margin-bottom: 6px; }
  h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.6rem;
    letter-spacing: 0.08em;
    background: linear-gradient(135deg, #f0b429 0%, #fff6d0 55%, #d48f00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }
  .tagline {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 6px;
  }

  /* ── DATE DISPLAY ── */
  .date-display {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 20px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .date-left { flex: 1; }

  .date-main {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.55rem;
    letter-spacing: 0.05em;
    color: var(--text);
    line-height: 1;
  }

  .date-sub {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 4px;
    text-transform: capitalize;
  }

  .clock-block {
    text-align: right;
  }

  .clock {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    line-height: 1;
  }

  .clock-sub {
    font-size: 0.62rem;
    color: var(--muted);
    text-align: right;
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ── STATUS ROW ── */
  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    font-size: 0.72rem;
    color: var(--muted);
    flex-wrap: wrap;
    gap: 6px;
  }

  .live-indicator {
    display: flex; align-items: center; gap: 6px;
    color: var(--red); font-weight: 600;
  }
  .live-dot {
    width: 7px; height: 7px;
    background: var(--red);
    border-radius: 50%;
    animation: blink 1.1s infinite;
    box-shadow: 0 0 6px var(--red);
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

  .update-time { color: var(--muted); font-size: 0.7rem; }

  /* ── MATCH CARD ── */
  .match-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 20px 16px;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
    transition: border-color .2s, transform .15s;
    animation: fadeIn .3s ease both;
  }
  @keyframes fadeIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:none} }
  .match-card:hover { transform: translateY(-2px); border-color: rgba(240,180,41,.2); }

  .match-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    border-radius: 14px 0 0 14px;
  }
  .match-card.live::before   { background: var(--red); box-shadow: 0 0 10px var(--red); }
  .match-card.done::before   { background: var(--green); }
  .match-card.upcoming::before { background: var(--accent); }

  .match-meta {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .group-pill {
    background: rgba(59,130,246,.12);
    color: var(--accent);
    border: 1px solid rgba(59,130,246,.25);
    border-radius: 5px;
    font-size: .65rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 2px 8px;
  }
  .venue-pill { font-size: .7rem; color: var(--muted); }

  .match-body {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
  }

  .team { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .team-flag { font-size: 2.6rem; line-height: 1; }
  .team-name { font-size: .82rem; font-weight: 600; text-align: center; color: var(--text); line-height: 1.2; }

  .score-block { text-align: center; }
  .score-nums { display: flex; align-items: center; gap: 6px; justify-content: center; }
  .score-box {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.8rem; line-height: 1;
    color: var(--text);
    background: rgba(255,255,255,.04);
    border: 1px solid var(--border);
    border-radius: 8px;
    width: 50px; text-align: center; padding: 2px 0;
  }
  .score-dash { color: var(--muted); font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem; }

  .status-label {
    margin-top: 7px;
    font-size: .7rem; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    text-align: center;
  }
  .status-label.live     { color: var(--red); }
  .status-label.done     { color: var(--green); }
  .status-label.upcoming { color: var(--muted); }

  /* ── EMPTY / INTRO ── */
  .empty-state {
    text-align: center; padding: 60px 20px; color: var(--muted);
    animation: fadeIn .4s ease both;
  }
  .empty-state .icon  { font-size: 3rem; display: block; margin-bottom: 12px; }
  .empty-state .title { font-size: 1.1rem; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .empty-state .sub   { font-size: .8rem; line-height: 1.7; }

  /* countdown */
  .countdown {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    max-width: 320px;
    margin-left: auto; margin-right: auto;
  }
  .countdown-unit {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 6px 8px;
    text-align: center;
  }
  .countdown-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem; color: var(--gold); line-height: 1;
    display: block;
  }
  .countdown-lbl { font-size: .6rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }

  .day-separator {
    font-size: .72rem;
    font-weight: 700;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: .1em;
    margin: 18px 0 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .day-separator:first-child { margin-top: 0; }

  /* spinner */
  .spinner-wrap { text-align: center; padding: 50px; }
  .spinner {
    display: inline-block; width: 30px; height: 30px;
    border: 3px solid var(--border); border-top-color: var(--gold);
    border-radius: 50%; animation: spin .75s linear infinite;
  }
  @keyframes spin { to{transform:rotate(360deg)} }

  footer { text-align: center; font-size: .63rem; color: var(--muted); margin-top: 8px; opacity: .55; }

  @media(max-width:400px) {
    .team-flag{font-size:2rem} .score-box{font-size:2.2rem;width:42px} .team-name{font-size:.74rem}
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <span class="logo">🏆</span>
    <h1>COUPE DU MONDE 2026</h1>
    <p class="tagline">USA · Canada · Mexique · 11 Juin – 19 Juillet</p>
  </header>

  <!-- DATE + HORLOGE -->
  <div class="date-display">
    <div class="date-left">
      <div class="date-main" id="date-main">—</div>
      <div class="date-sub"  id="date-sub">—</div>
    </div>
    <div class="clock-block">
      <div class="clock" id="clock">00:00:00</div>
      <div class="clock-sub">Heure locale</div>
    </div>
  </div>

  <!-- STATUS -->
  <div class="status-row">
    <div id="live-indicator" class="live-indicator" style="display:none">
      <span class="live-dot"></span> Matchs en direct
    </div>
    <span id="update-time" class="update-time"></span>
  </div>

  <!-- MATCHS -->
  <div id="matches-container">
    <div class="spinner-wrap"><div class="spinner"></div></div>
  </div>

  <footer id="data-source"></footer>
</div>

<script>
// ──────────────────────────────────────────────
// SOURCE DE DONNÉES — 26worldcup.github.io (open source, CC0)
// Dépôt : github.com/26worldcup/26worldcup.github.io
// Mis à jour automatiquement par leur pipeline (api.fifa.com, etc.)
// Servi via raw.githubusercontent.com → CORS activé (*), pas de clé requise
// ──────────────────────────────────────────────
const DATA_BASE = 'https://raw.githubusercontent.com/26worldcup/26worldcup.github.io/main/public/data';

// Petits ajustements de noms FR (le JSON source utilise des variantes officielles)
const FR_NAME_OVERRIDES = {
  BIH: 'Bosnie-Herzégovine',
  COD: 'Congo RD',
  KOR: 'Corée du Sud',
  IRN: 'Iran',
  PAN: 'Panama',
  KSA: 'Arabie Saoudite',
  CIV: "Côte d'Ivoire",
};

// Libellés FR pour les phases (utilisés hors phase de groupes)
const STAGE_LABELS = {
  group: null, // affiché via "group"
  r32: '32es de finale',
  r16: 'Huitièmes de finale',
  qf:  'Quarts de finale',
  sf:  'Demi-finales',
  third: 'Match pour la 3e place',
  final: 'Finale',
};

let TEAMS  = {};   // code -> { fr, flag, group }
let VENUES = {};   // venueId -> ville
let MATCHES = [];  // tableau brut de matches.json
let usingApi = false;
let lastRenderedDate = null;

// ──────────────────────────────────────────────
// EMOJI DRAPEAU à partir du code ISO2
// ──────────────────────────────────────────────
function flagEmoji(iso2) {
  const special = {
    'GB-ENG': '🏴󠁧󠁢󠁥󠁮󠁧󠁿',
    'GB-SCT': '🏴󠁧󠁢󠁳󠁣󠁴󠁿',
    'GB-WLS': '🏴󠁧󠁢󠁷󠁬󠁳󠁿',
  };
  if (special[iso2]) return special[iso2];
  if (!iso2 || iso2.length !== 2) return '🏳️';
  const points = iso2.toUpperCase().split('').map(c => 127397 + c.charCodeAt(0));
  return String.fromCodePoint(...points);
}

// ──────────────────────────────────────────────
// HELPERS DATE
// ──────────────────────────────────────────────
const WC_START = '2026-06-11';
const WC_END   = '2026-07-19';

function toYMD(d) {
  const y = d.getFullYear();
  const m = String(d.getMonth()+1).padStart(2,'0');
  const day = String(d.getDate()).padStart(2,'0');
  return `${y}-${m}-${day}`;
}

function todayStr() { return toYMD(new Date()); }

function yesterdayStr() {
  const d = new Date();
  d.setDate(d.getDate() - 1);
  return toYMD(d);
}

function formatDateFR(str) {
  const d = new Date(str + 'T12:00:00');
  return d.toLocaleDateString('fr-FR', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
}

// ──────────────────────────────────────────────
// HORLOGE EN TEMPS RÉEL (se met à jour chaque seconde)
// ──────────────────────────────────────────────
function tickClock() {
  const now  = new Date();
  const hh   = String(now.getHours()).padStart(2,'0');
  const mm   = String(now.getMinutes()).padStart(2,'0');
  const ss   = String(now.getSeconds()).padStart(2,'0');
  document.getElementById('clock').textContent = `${hh}:${mm}:${ss}`;

  const today = todayStr();
  document.getElementById('date-main').textContent = formatDateFR(today)
    .replace(/^\w/, c => c.toUpperCase());
  document.getElementById('date-sub').textContent =
    today >= WC_START && today <= WC_END
      ? `Jour de tournoi · Matchs du ${now.toLocaleDateString('fr-FR',{day:'numeric',month:'long'})}`
      : today < WC_START ? 'Avant le tournoi' : 'Tournoi terminé';

  // Changement de jour automatique : si la date a changé depuis le dernier rendu → re-render
  if (lastRenderedDate && lastRenderedDate !== today) {
    lastRenderedDate = today;
    renderMatches();
  }
}

// ──────────────────────────────────────────────
// FETCH DES DONNÉES (équipes + venues une fois, matchs à chaque refresh)
// ──────────────────────────────────────────────
async function fetchStaticData() {
  const [teamsRes, venuesRes] = await Promise.all([
    fetch(`${DATA_BASE}/teams.json`),
    fetch(`${DATA_BASE}/venues.json`),
  ]);
  const teamsData  = await teamsRes.json();
  const venuesData = await venuesRes.json();

  for (const [code, t] of Object.entries(teamsData.teams)) {
    TEAMS[code] = {
      fr: FR_NAME_OVERRIDES[code] || t.name.fr,
      flag: flagEmoji(t.iso2),
      group: t.group,
    };
  }
  for (const [id, v] of Object.entries(venuesData.venues)) {
    VENUES[id] = v.city;
  }
}

async function fetchLiveData() {
  try {
    if (Object.keys(TEAMS).length === 0) {
      await fetchStaticData();
    }
    const r = await fetch(`${DATA_BASE}/matches.json`, { cache: 'no-store' });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const data = await r.json();
    MATCHES = Array.isArray(data.matches) ? data.matches : [];
    usingApi = true;
    document.getElementById('data-source').textContent =
      'Source : 26worldcup.github.io (open data) · Scores actualisés automatiquement';
  } catch (e) {
    usingApi = false;
    console.warn('Impossible de récupérer les données du tournoi :', e);
    document.getElementById('data-source').textContent =
      '⚠️ Source de données momentanément indisponible — nouvelle tentative dans 1 min';
  }
  document.getElementById('update-time').textContent =
    'Actualisé à ' + new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
  renderMatches();
}

// ──────────────────────────────────────────────
// STATUT DU MATCH
// ──────────────────────────────────────────────
function mapStatus(raw) {
  if (raw === 'finished')  return 'done';
  if (raw === 'live')      return 'live';
  if (raw === 'postponed') return 'postponed';
  return 'upcoming'; // scheduled
}

// ──────────────────────────────────────────────
// DÉCODAGE DES PLACEHOLDERS POUR LES MATCHS À DÉTERMINER
// (ex: "1A" = 1er du groupe A, "2B" = 2e du groupe B, "W73" = vainqueur match 73)
// ──────────────────────────────────────────────
function decodePlaceholder(ph) {
  if (!ph) return 'À déterminer';
  let m = ph.match(/^([123])([A-L])$/);
  if (m) {
    const pos = m[1] === '1' ? '1er' : m[1] === '2' ? '2e' : '3e';
    return `${pos} Groupe ${m[2]}`;
  }
  m = ph.match(/^W(\d+)$/);
  if (m) return `Vainqueur Match ${m[1]}`;
  m = ph.match(/^L(\d+)$/);
  if (m) return `Perdant Match ${m[1]}`;
  return 'À déterminer';
}

// ──────────────────────────────────────────────
// CONSTRUCTION DES MATCHS POUR UNE DATE DONNÉE (locale)
// ──────────────────────────────────────────────
function getMatchesForDate(dateStr) {
  if (!usingApi || !MATCHES.length) return [];

  return MATCHES
    .filter(m => m.date && toYMD(new Date(m.date)) === dateStr)
    .map(m => {
      const homeTeam = m.home?.code ? TEAMS[m.home.code] : null;
      const awayTeam = m.away?.code ? TEAMS[m.away.code] : null;
      const kickoff  = new Date(m.date);

      const groupLabel = m.group
        ? `Groupe ${m.group}`
        : (STAGE_LABELS[m.stage] || m.stage);

      return {
        groupLabel,
        home:     homeTeam ? homeTeam.fr : decodePlaceholder(m.phA),
        homeFlag: homeTeam ? homeTeam.flag : '🏳️',
        away:     awayTeam ? awayTeam.fr : decodePlaceholder(m.phB),
        awayFlag: awayTeam ? awayTeam.flag : '🏳️',
        venue:    VENUES[m.venueId] || '',
        time:     kickoff.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'}),
        kickoff,
        homeScore: m.home?.score ?? null,
        awayScore: m.away?.score ?? null,
        status:    mapStatus(m.status),
        minute:    m.time || null, // ex: "45'"
      };
    })
    .sort((a, b) => a.kickoff - b.kickoff);
}

// ──────────────────────────────────────────────
// COUNTDOWN vers le 11 juin (avant le début du tournoi)
// ──────────────────────────────────────────────
function getCountdown() {
  const target = new Date('2026-06-11T00:00:00');
  const diff   = target - new Date();
  if (diff <= 0) return null;
  const total  = Math.floor(diff / 1000);
  const s = total % 60;
  const m = Math.floor(total/60) % 60;
  const h = Math.floor(total/3600) % 24;
  const d = Math.floor(total/86400);
  return {d,h,m,s};
}

function updateCountdownDisplay() {
  const cd = getCountdown();
  if (!cd) return;
  const dEl = document.getElementById('cd-d');
  const hEl = document.getElementById('cd-h');
  const mEl = document.getElementById('cd-m');
  const sEl = document.getElementById('cd-s');
  if (dEl) dEl.textContent = cd.d;
  if (hEl) hEl.textContent = String(cd.h).padStart(2,'0');
  if (mEl) mEl.textContent = String(cd.m).padStart(2,'0');
  if (sEl) sEl.textContent = String(cd.s).padStart(2,'0');
}

// ──────────────────────────────────────────────
// RENDER
// ──────────────────────────────────────────────
function renderMatches() {
  const today     = todayStr();
  const yesterday = yesterdayStr();
  lastRenderedDate = today;

  const container = document.getElementById('matches-container');

  // Source pas encore chargée
  if (!usingApi) {
    container.innerHTML = `<div class="spinner-wrap"><div class="spinner"></div></div>`;
    return;
  }

  const matchesYesterday = getMatchesForDate(yesterday).map(m => ({...m, _day: 'yesterday'}));
  const matchesToday     = getMatchesForDate(today).map(m => ({...m, _day: 'today'}));
  const matches = [...matchesYesterday, ...matchesToday];

  const hasLive = matches.some(m => m.status === 'live');
  document.getElementById('live-indicator').style.display = hasLive ? 'flex' : 'none';

  // Avant le tournoi
  if (today < WC_START) {
    const cd = getCountdown();
    const cdHtml = cd ? `
      <div class="countdown">
        <div class="countdown-unit"><span class="countdown-num" id="cd-d">${cd.d}</span><span class="countdown-lbl">Jours</span></div>
        <div class="countdown-unit"><span class="countdown-num" id="cd-h">${String(cd.h).padStart(2,'0')}</span><span class="countdown-lbl">Heures</span></div>
        <div class="countdown-unit"><span class="countdown-num" id="cd-m">${String(cd.m).padStart(2,'0')}</span><span class="countdown-lbl">Min</span></div>
        <div class="countdown-unit"><span class="countdown-num" id="cd-s">${String(cd.s).padStart(2,'0')}</span><span class="countdown-lbl">Sec</span></div>
      </div>` : '';
    container.innerHTML = `<div class="empty-state">
      <span class="icon">⏳</span>
      <div class="title">Le tournoi commence le 11 juin 2026</div>
      <div class="sub">Mexique 🇲🇽 vs Afrique du Sud 🇿🇦 — match d'ouverture à Mexico City</div>
      ${cdHtml}
    </div>`;
    return;
  }

  // Après le tournoi
  if (today > WC_END) {
    container.innerHTML = `<div class="empty-state">
      <span class="icon">🏅</span>
      <div class="title">Tournoi terminé</div>
      <div class="sub">La Coupe du Monde 2026 s'est achevée le 19 juillet 2026.<br>Merci pour votre suivi !</div>
    </div>`;
    return;
  }

  // Pas de match sur les deux jours
  if (matches.length === 0) {
    container.innerHTML = `<div class="empty-state">
      <span class="icon">⚽</span>
      <div class="title">Pas de match hier ni aujourd'hui</div>
      <div class="sub">Profitez de la pause — les matchs reprennent bientôt.</div>
    </div>`;
    return;
  }

  // Affichage des matchs avec séparateurs de jour
  let html = '';
  let lastDay = null;
  for (const m of matches) {
    if (m._day !== lastDay) {
      lastDay = m._day;
      const label = lastDay === 'yesterday'
        ? `Hier · ${new Date(yesterday + 'T12:00:00').toLocaleDateString('fr-FR',{day:'numeric',month:'long'})}`
        : `Aujourd'hui · ${new Date(today + 'T12:00:00').toLocaleDateString('fr-FR',{day:'numeric',month:'long'})}`;
      html += `<div class="day-separator">${label}</div>`;
    }
    html += renderCard(m);
  }
  container.innerHTML = html;
}

function renderCard(m) {
  const hs  = m.homeScore !== null ? m.homeScore : '–';
  const as_ = m.awayScore !== null ? m.awayScore : '–';

  let statusHtml;
  if (m.status === 'live') {
    const min = m.minute ? m.minute : 'EN COURS';
    statusHtml = `<div class="status-label live"><span style="display:inline-block">⚽</span> Score en direct · ${min}</div>`;
  } else if (m.status === 'done') {
    statusHtml = `<div class="status-label done">✓ Match terminé</div>`;
  } else if (m.status === 'postponed') {
    statusHtml = `<div class="status-label upcoming">⏸ Reporté</div>`;
  } else {
    statusHtml = `<div class="status-label upcoming">🕐 ${m.time}</div>`;
  }

  return `<div class="match-card ${m.status}">
    <div class="match-meta">
      <span class="group-pill">${m.groupLabel}</span>
      <span class="venue-pill">🏟 ${m.venue}</span>
    </div>
    <div class="match-body">
      <div class="team">
        <span class="team-flag">${m.homeFlag}</span>
        <span class="team-name">${m.home}</span>
      </div>
      <div class="score-block">
        <div class="score-nums">
          <span class="score-box">${hs}</span>
          <span class="score-dash">–</span>
          <span class="score-box">${as_}</span>
        </div>
        ${statusHtml}
      </div>
      <div class="team">
        <span class="team-flag">${m.awayFlag}</span>
        <span class="team-name">${m.away}</span>
      </div>
    </div>
  </div>`;
}

// ──────────────────────────────────────────────
// TICK GLOBAL (chaque seconde)
// ──────────────────────────────────────────────
function tick() {
  tickClock();
  updateCountdownDisplay();
}

// ──────────────────────────────────────────────
// INIT
// ──────────────────────────────────────────────
lastRenderedDate = todayStr();
tick();
setInterval(tick, 1000);          // horloge + détection changement de jour
fetchLiveData();                   // premier fetch
setInterval(fetchLiveData, 60000); // refresh toutes les 60s
</script>
